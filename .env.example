# Generate independent values using `openssl rand -hex 32`. Do not commit .env.
SNIPER_API_TOKEN=
SNIPER_MASTER_KEY=
SNIPER_CONFIG=config/default.toml
# Environment secrets take precedence over encrypted vault values.
SNIPER_HELIUS_RPC_URL=
SNIPER_HELIUS_WEBSOCKET_URL=
SNIPER_HELIUS_PREPROCESSED_URL=
SNIPER_HELIUS_SENDER_URL=
SNIPER_JITO_URL=
# Trading keypairs are read only by Rust. Never set NEXT_PUBLIC_* for secrets.
SNIPER_MAINNET_WALLET=
SNIPER_DEVNET_WALLET=
SNIPER_DEVNET_RPC_URL=
# Next.js server-only settings
SNIPER_BACKEND_URL=http://127.0.0.1:8787
SNIPER_BROWSER_ORIGIN=https://localhost:3443
SNIPER_UI_PASSWORD=
